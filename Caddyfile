# Plain HTTP on port 80 inside the container. HTTPS comes from the Cloudflare
# Tunnel or whatever reverse proxy sits in front.
:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# The music folder. `browse` is what gives the page its track list: the
	# player requests /music/ as JSON, so new files show up without a rebuild.
	handle_path /music/* {
		root * /music
		@audio path *.mp3 *.ogg *.opus *.m4a *.flac *.wav
		header @audio Cache-Control "public, max-age=2592000"
		file_server browse
	}

	handle {
		root * /srv
		file_server
	}
}
