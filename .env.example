# Copy this file to .env (next to compose.yaml) and change what you need.
# .env is gitignored, so your settings and token never get committed and
# `git pull` always applies cleanly. Every line is optional.

# Port the site is published on, on the host.
PORT=8090

# Host address the port is published on. 0.0.0.0 means every network
# interface. Use 127.0.0.1 to keep it on this machine only, for example when
# the Cloudflare Tunnel below is the only way in.
BIND_ADDRESS=0.0.0.0

# Folder that holds the music files.
MUSIC_DIR=./mp3s

# Cloudflare Tunnel (optional). Uncomment both lines to start the tunnel.
# The token comes from Zero Trust > Networks > Tunnels. In the tunnel's
# public hostname, set the service to http://web:80.
# Keep this file private once it holds a token: chmod 600 .env
#COMPOSE_PROFILES=tunnel
#TUNNEL_TOKEN=
