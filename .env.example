# Copy to .env (or paste into Dockge's ".env" box) and change what you need.
# Every line is optional; the values below are the defaults.

# ":80" = plain HTTP, for running behind Cloudflare or another reverse proxy.
# A domain name (e.g. keygenjukebox.net) = Caddy gets its own HTTPS certificate;
# ports 80 and 443 must then be reachable from the internet.
SITE_ADDRESS=:80

# Ports on the host.
HTTP_PORT=80
HTTPS_PORT=443

# Folder that holds the music files.
MUSIC_DIR=./mp3s
